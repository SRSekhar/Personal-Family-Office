{
  "name": "@pfo/reports",
  "version": "0.1.0",
  "description": "Deterministic, offline-capable financial report generation for PFO OS.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "lint": "eslint src",
    "format": "prettier src --write",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pfo/analytics": "workspace:*"
  },
  "devDependencies": {
    "@pfo/models": "workspace:*",
    "typescript": "^6.0.3"
  }
}
