{
  "name": "personal-family-office",
  "version": "0.1.0",
  "description": "PFO OS - Personal Family Office Operating System",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
  "bootstrap": "pwsh ./scripts/build/Initialize-PFO.ps1",
  "validate": "pwsh ./scripts/build/Initialize-PFO.ps1 -Validate",
  "doctor": "pwsh ./scripts/build/Initialize-PFO.ps1 -Doctor",
  "build": "echo \"Build pipeline will be implemented.\"",
  "lint": "eslint .",
  "format": "prettier . --write",
  "format:check": "prettier . --check",
  "test": "vitest",
  "test:watch": "vitest --watch",
  "test:coverage": "vitest run --coverage"
},
  "keywords": [
    "pfo",
    "family-office",
    "finance",
    "wealth-management",
    "ai",
    "typescript"
  ],
  "author": "Principal",
  "license": "UNLICENSED",
  "repository": {
  "type": "git",
  "url": "https://github.com/SRSekhar/Personal-Family-Office.git"
  },
  "homepage": "https://github.com/SRSekhar/Personal-Family-Office",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
  "@eslint/js": "^10.0.1",
  "@types/node": "^26.1.0",
  "eslint": "^10.6.0",
  "globals": "^16.4.0",
  "prettier": "^3.9.4",
  "rimraf": "^6.1.3",
  "tsx": "^4.23.0",
  "typescript": "^6.0.3",
  "typescript-eslint": "^8.40.0",
  "@vitest/coverage-v8": "^3.2.4",
  "vitest": "^3.2.4"
}
}