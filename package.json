{
  "name": "personal-family-office",
  "version": "0.1.0",
  "description": "PFO OS - Personal Family Office Operating System",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "bootstrap": "pwsh ./scripts/build/Initialize-PFO.ps1",
    "dashboard:serve": "node scripts/dashboard/serve.mjs",
    "validate": "pwsh ./scripts/build/Initialize-PFO.ps1 -Validate",
    "doctor": "pwsh ./scripts/build/Initialize-PFO.ps1 -Doctor",
    "build": "pnpm --recursive --filter './packages/**' --filter './apps/cli' --if-present run build",
    "typecheck": "pnpm build && pnpm --recursive --filter './packages/**' --filter './apps/cli' --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "security:licenses": "node scripts/security/Generate-LicenseInventory.mjs"
  },
  "keywords": [
    "pfo",
    "family-office",
    "finance",
    "wealth-management",
    "ai",
    "typescript"
  ],
  "author": "Principal",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/SRSekhar/Personal-Family-Office.git"
  },
  "homepage": "https://github.com/SRSekhar/Personal-Family-Office",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "vitest": "^5.0.3"
  }
}
